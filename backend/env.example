# BinBuddy Environment Variables
# Copy this to .env and fill your actual values

# Flask
SECRET_KEY=your-super-secret-key-change-this
DEBUG=True

# MySQL Database
DB_HOST=localhost
DB_USER=binbuddy_user
DB_PASSWORD=binbuddy_pass
DB_NAME=binbuddy_db

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-this

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5000
